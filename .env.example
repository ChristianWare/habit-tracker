# ─────────────────────────────────────────────────────────────────────────────
#  Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string (Neon, Supabase, etc.). REQUIRED
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Signs your login session. REQUIRED. Make one with:  npx auth secret
AUTH_SECRET=""

# Your time zone. "Today" and the calendar use it. Optional.
APP_TIMEZONE="America/Phoenix"
